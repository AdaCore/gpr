project Prj is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnateDDEF_A=111",
         "-gnateDDEF_B_SPEC=222",
         "-gnateDDEF_B_BODY=333",
         "-gnateDDEF_C_BODY=444",
         "-gnateDDEF_SEP_VALUE=555",
         "-gnateG");
   end Compiler;

end Prj;
