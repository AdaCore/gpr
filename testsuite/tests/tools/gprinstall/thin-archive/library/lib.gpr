library project Lib is
   for Languages use ("C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "checked";
   for Library_Kind use "static";
   for Library_Dir use "lib";
   for Archive_Builder use ("ar", "csrD");

   Mode := external ("ARCHIVE_MODE", "normal");
   case Mode is
      when "thin" =>
         for Archive_Builder_Transient_Options use ("--thin");
      when others =>
         for Archive_Builder_Transient_Options use ();
   end case;
end Lib;
