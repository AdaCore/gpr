library project Hello is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "hello";
   for Library_Kind use "relocatable";
   for Library_Interface use ("Hello");
   for Library_Standalone use "standard";

   --  This is what triggers the bug: a real Library_Symbol_File containing
   --  an ordinary blank line.
   for Library_Symbol_File use "symbols.txt";
end Hello;
