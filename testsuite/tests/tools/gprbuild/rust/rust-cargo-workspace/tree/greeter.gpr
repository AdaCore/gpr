library project Greeter is
   for Languages use ("Rust");
   for Library_Name use "greeter";
   for Library_Dir use "lib";
   for Source_Dirs use ("rust/greeter/src");

   package Naming is
      for Body_Suffix ("Rust") use ".rs";
   end Naming;

   package Cargo is
      for Root use Project'Project_Dir & "rust/greeter";
   end Cargo;
end Greeter;
