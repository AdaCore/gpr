project Prj is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   package Compiler is
      --  Integrated preprocessing: -gnateD defines a symbol and -gnateG makes
      --  the compiler save the preprocessed form of every Ada source it
      --  compiles next to the object as "<source name>.prep".
      for Default_Switches ("Ada") use ("-gnateDLEVEL=2", "-gnateG");
   end Compiler;
end Prj;
