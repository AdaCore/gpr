--  Builds the actual library. Its result is what external_library.gpr then
--  presents as an externally built library.

library project Provider is
   for Languages use ("C");
   for Source_Dirs use ("src", "../include");
   for Object_Dir use "obj";

   for Library_Name use "ReproProvider";
   for Library_Dir use "../lib";
   for Library_Kind use "static";
end Provider;
