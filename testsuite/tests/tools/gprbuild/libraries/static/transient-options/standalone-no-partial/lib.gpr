library project Lib is

   for Library_Name use "checked";
   for Library_Kind use "static";
   for Library_Dir use "lib";
   for Object_Dir use "obj";

   for Archive_Builder use ("ar", "csrD");
   Mode := external ("ARCHIVE_MODE", "default");
   case Mode is
      when "thin" =>
         for Archive_Builder_Transient_Options use ("--thin");
      when "legacy" =>
         for Archive_Builder_Transient_Options use ("-T");
      when "normal" =>
         for Archive_Builder_Transient_Options use ();
      when others =>
         null;
   end case;
   for Library_Partial_Linker use ();
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Library_Interface use ("pkg");
   for Library_Standalone use "standard";
end Lib;
