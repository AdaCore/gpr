library project Dependency is
   for Library_Name use "dependency";
   for Library_Kind use "static";
   for Library_Dir use "lib";
   for Object_Dir use "obj";
   for Languages use ("C");
   for Source_Dirs use ("src");

   for Archive_Builder use ("ar", "csrD");
   Mode := external ("ARCHIVE_MODE", "default");
   case Mode is
      when "thin" =>
         for Archive_Builder_Transient_Options use ("--thin");
      when "legacy" =>
         for Archive_Builder_Transient_Options use ("-T");
      when "normal" =>
         for Archive_Builder_Transient_Options use ();
      when others =>
         null;
   end case;
end Dependency;
