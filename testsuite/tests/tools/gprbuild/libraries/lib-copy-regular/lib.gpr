library project Lib is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "lib";
   for Library_Dir use "libdir";
   for Library_ALI_Dir use "ali";
   for Library_Kind use "static";

   --  Not standalone: the copy action is fed by the Link action, which
   --  publishes every unit of the view.

   for Library_Standalone use "no";

end Lib;
