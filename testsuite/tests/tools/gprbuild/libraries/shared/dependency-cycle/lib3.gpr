with "lib1";
with "lib2";

--  Lib1 and Lib2 depend on each other, so linking Lib3 against them needs
--  the linker group switches.

library project Lib3 is
   for Languages use ("C");
   for Library_Name use "lib3";
   for Library_Kind use "relocatable";
   for Source_Dirs use ("src/lib3");
   for Object_Dir use "obj/lib3";
   for Library_Dir use "lib/lib3";
end Lib3;
