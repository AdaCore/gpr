with "foreign.gpr";
project App is
   for Languages use ("C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.c");
   for Archive_Builder use
     (external ("PYTHON", "python3"),
      App'Project_Dir & "archive-driver.py", "csrD");
   for Archive_Builder_Transient_Options use
     ("--custom-thin", "--custom-label", "argument with spaces");
end App;
