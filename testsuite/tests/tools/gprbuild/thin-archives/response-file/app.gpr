with "foreign.gpr";
project App is
   for Languages use ("C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.c");
   for Archive_Builder use ("ar", "csrD");
   Mode := external ("MODE", "default");
   case Mode is
      when "normal" =>
         for Archive_Builder_Transient_Options use ();
      when "thin" =>
         for Archive_Builder_Transient_Options use ("--thin");
      when others =>
         null;
   end case;
   package Linker is
      for Max_Command_Line_Length use "1";
      for Response_File_Format use "GCC_Object_List";
      for Response_File_Switches use ("@");
   end Linker;
end App;
