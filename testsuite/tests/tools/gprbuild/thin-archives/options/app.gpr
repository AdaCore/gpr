with "foreign.gpr";
project App is
   for Languages use ("C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.c");
   for Archive_Builder use ("ar", "csrD");
   Mode := external ("MODE", "default");
   case Mode is
      when "normal" =>
         for Archive_Builder_Transient_Options use ();
      when "legacy" =>
         for Archive_Builder_Transient_Options use ("-T");
      when "thin" =>
         for Archive_Builder_Transient_Options use ("--thin");
      when "multiple" =>
         for Archive_Builder_Transient_Options use
           ("--thin", "-D");
      when "other" =>
         for Archive_Builder_Transient_Options use
           ("-D");
      when others =>
         null;
   end case;
end App;
