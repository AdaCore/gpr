library project Lib is
   for Library_Name use "greeter";
   for Library_Dir use "lib";
   for Library_Ali_Dir use "ali";
   for Library_Src_Dir use "srcs";
   for Object_Dir use "obj";
   for Source_Dirs use ("src");
   for Library_Interface use ("greeter");
   for Library_Auto_Init use "True";
   --  Do NOT set "for Library_Partial_Linker use ();" here: an empty
   --  override disables partial linking, which is what normally merges
   --  b__greeter.o (carrying the auto-init constructor) together with
   --  greeter.o into one archive member. Without it, nothing in a
   --  consumer directly references a symbol inside b__greeter.o, so the
   --  static linker never extracts it from the archive and the SAL's
   --  runtime elaboration (e.g. Ada.Text_IO) silently never happens --
   --  this is exactly what caused the ADA.IO_EXCEPTIONS.STATUS_ERROR
   --  seen while developing this test.
end Lib;
