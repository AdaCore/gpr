library project Worker_Tasking_Lib is
   for Library_Name use "worker_tasking";
   for Library_Dir use "lib";
   for Library_Ali_Dir use "ali";
   for Library_Src_Dir use "srcs";
   for Object_Dir use "obj";
   for Source_Dirs use ("src");
   for Library_Interface use ("worker");
   for Library_Auto_Init use "True";
   --  Do NOT set "for Library_Partial_Linker use ();" -- see tree/lib.gpr
   --  for why an empty override breaks auto-init.
end Worker_Tasking_Lib;
