with "../../gpr2";

library project GPR2tools.Common extends "gpr2tools.gpr" is

   for Source_Dirs use ("../src");
   for Object_Dir use GPR2tools.Base_Object_Dir;
   for Library_Name use "gpr2tools_common";
   for Library_Dir use
     GPR2_Shared.Build_Root & "/" & GPR2_Shared.Build & "/lib-tools-common";

   package Builder is
      for Global_Configuration_Pragmas use
        Project'Project_Dir & "../gpr2_tools_restrictions.adc";
   end Builder;

end GPR2tools.Common;
